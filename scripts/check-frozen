#!/usr/bin/env bash
# Frozen-set check: KERNEL.md and INVARIANTS.md (whole files) and the
# `## kernel` and `## invariants` sections of GLOSSARY.md keep the bytes the
# user approved. Each item's sha256 is pinned in scripts/frozen.sha256. A
# glossary section runs from its heading to the next `## ` heading, trailing
# blank lines dropped, so mutable sections and frontmatter stay editable.
#
# Usage: scripts/check-frozen         check every pin
#        scripts/check-frozen --pin   rewrite the pins (init, a promotion, or an
#                                     edit to an unpromoted fork's draft set)
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"
ITEMS=(KERNEL.md INVARIANTS.md GLOSSARY.md#kernel GLOSSARY.md#invariants)
PINS=scripts/frozen.sha256

# Print item's bytes: a whole file, or FILE#name for the `## name` section.
item() {
  case "$1" in
  *'#'*) awk -v h="## ${1#*#}" '/^## /{f=($0==h)} f{buf=buf $0 "\n"; if (NF) {printf "%s", buf; buf=""}}' "${1%%#*}" ;;
  *) cat "$1" ;;
  esac
}
sum() { item "$1" | sha256sum | cut -d' ' -f1; }

if [[ "${1:-}" == --pin ]]; then
  {
    echo "# sha256 of the frozen set, checked by scripts/check-frozen."
    echo "# Change this file only when the user promotes a fork, or in an unpromoted fork after editing its draft frozen set."
    for name in "${ITEMS[@]}"; do echo "$(sum "$name") $name"; done
  } >"$PINS"
  echo "pinned ${#ITEMS[@]} items in $PINS"
  exit 0
fi

status=0
n=0
while read -r pin name; do
  [[ -z "$pin" || "$pin" == '#'* ]] && continue
  n=$((n + 1))
  if [[ -z "$(item "$name" 2>/dev/null)" ]]; then
    echo "FAIL frozen: $name is missing or empty" >&2; status=1; continue
  fi
  got="$(sum "$name")"
  if [[ "$got" != "$pin" ]]; then
    echo "FAIL frozen: $name changed (sha256 $got, pinned $pin); re-pin only for a promoted fork, or in a draft fork after a frozen edit" >&2
    status=1
  fi
done <"$PINS"
((n == ${#ITEMS[@]})) || { echo "FAIL frozen: $PINS pins $n items, expected ${#ITEMS[@]}" >&2; status=1; }

[[ "$status" == 0 ]] && echo "PASS frozen: $n pinned items match $PINS"
exit "$status"
