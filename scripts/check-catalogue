#!/usr/bin/env bash
# Proof 9: exits 0 only when every Candidate in the reused set (the archive's 10,001 skills) has a Trace,
# which records it as unresolvable when its source no longer resolves, and a Determination; and every
# Catalogue skill has a Classification and a Footprint. Reads only this repository.
